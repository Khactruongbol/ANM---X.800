Options -Indexes
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8
</IfModule>
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar)$">
    Require all denied
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
