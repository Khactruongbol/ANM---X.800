[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = req_ext

[dn]
C = VN
ST = Ho Chi Minh
L = Ho Chi Minh
O = Machtin Local Lab
OU = X800 Security Project
CN = machtin.local

[req_ext]
subjectAltName = @alt_names
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = machtin.local
DNS.2 = localhost
IP.1 = 127.0.0.1
IP.2 = ::1
