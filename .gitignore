# Chỉ track workflow chính trong docs
docs/*
!docs/
!docs/Workflow*

# Không track tài liệu tham khảo/ghi chú sinh thêm
references/

# Không track file runtime/log thực tế, chỉ giữ .gitkeep
logs/**/*.log
logs/**/*.txt
!logs/**/.gitkeep
evidence/screenshots/*
evidence/wireshark/*
evidence/test-results/*
!evidence/**/.gitkeep

# Không track chứng thư/khóa thật, chỉ giữ khung thư mục
certs/*
!certs/.gitkeep
*.key
*.crt
*.pem

# Hệ điều hành / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/

# Runtime/dependency phổ biến
node_modules/
vendor/
*.log
*.tmp
*.bak
app/website-tin-tuc/backend/runtime/*
!app/website-tin-tuc/backend/runtime/.gitkeep

# Nested git từ source copy
app/website-tin-tuc/.git/

# Codex presentation build intermediates
.codex-finalizer/
.codex-presentation-build/

# Local presentation renders and temporary image variants
tmp/
